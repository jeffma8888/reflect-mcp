# Copy to .env and fill in for LIVE use. Offline tests + `make eval` need NONE of this.

# Which provider the Generator + Critic call. One of: anthropic | openai | bedrock
REFLECT_PROVIDER=anthropic

# Generator and Critic SHOULD be different models (multi-model reflection).
REFLECT_GENERATOR_MODEL=claude-3-5-sonnet-latest
REFLECT_CRITIC_MODEL=claude-3-5-haiku-latest

# Provider credentials (set only the one matching REFLECT_PROVIDER)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AWS_REGION=us-east-1          # for bedrock; uses your default AWS credential chain

# Logging
REFLECT_LOG_LEVEL=INFO
